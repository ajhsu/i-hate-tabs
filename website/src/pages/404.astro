---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Page not found: I Hate Tabs"
  description="This page does not exist."
  noindex
>
  <section class="px-6 py-32 text-center">
    <p class="eyebrow">404</p>
    <h1 class="mt-4 text-4xl font-extrabold tracking-tight md:text-6xl">
      This tab does not exist.
    </h1>
    <p class="mt-5 text-lg text-text-secondary">
      Maybe you closed it. It happens to everyone.
    </p>
    <a href="/" class="btn-primary mt-10">Back to the home page</a>
  </section>
</Layout>
