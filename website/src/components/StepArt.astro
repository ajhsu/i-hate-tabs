---
interface Props {
  step: 1 | 2 | 3;
}

const { step } = Astro.props;
const dots = ['#ff6b6b', '#feca57', '#48dbfb', '#1dd1a1', '#a29bfe', '#ff9ff3'];
---

<svg
  viewBox="0 0 240 140"
  class="h-auto w-full"
  aria-hidden="true"
  xmlns="http://www.w3.org/2000/svg"
>
  <rect
    x="8"
    y="8"
    width="224"
    height="124"
    rx="12"
    fill="#1b1b2a"
    stroke="#2c2c42"></rect>
  <path d="M8 20a12 12 0 0 1 12-12h200a12 12 0 0 1 12 12v14H8z" fill="#23233a"
  ></path>
  <circle cx="20" cy="21" r="3" fill="#ff5f57"></circle>
  <circle cx="29" cy="21" r="3" fill="#febc2e"></circle>
  {
    step === 1 && (
      <g>
        {Array.from({ length: 11 }, (_, i) => (
          <g>
            <rect
              x={40 + i * 14}
              y="16"
              width="12"
              height="18"
              rx="3"
              fill="#2f2f48"
            />
            <circle cx={46 + i * 14} cy="25" r="2.6" fill={dots[i % 6]} />
          </g>
        ))}
        <rect x="24" y="48" width="110" height="9" rx="4.5" fill="#33334d" />
        <rect x="24" y="66" width="192" height="6" rx="3" fill="#2a2a40" />
        <rect x="24" y="79" width="170" height="6" rx="3" fill="#2a2a40" />
        <rect x="24" y="96" width="58" height="26" rx="6" fill="#2a2a40" />
        <rect x="91" y="96" width="58" height="26" rx="6" fill="#2a2a40" />
        <rect x="158" y="96" width="58" height="26" rx="6" fill="#2a2a40" />
      </g>
    )
  }
  {
    (step === 2 || step === 3) && (
      <g>
        <rect x="40" y="16" width="74" height="18" rx="4" fill="#33334d" />
        <circle cx="50" cy="25" r="4" fill="#fdd835" />
        <rect x="58" y="23" width="44" height="4" rx="2" fill="#a3a3bd" />
        {Array.from({ length: 5 }, (_, i) => (
          <g>
            <circle cx="30" cy={52 + i * 15} r="3.2" fill={dots[i]} />
            <rect
              x="40"
              y={49 + i * 15}
              width={150 - i * 16}
              height="6"
              rx="3"
              fill={step === 3 && i === 2 ? '#6c5ce7' : '#3a3a55'}
            />
          </g>
        ))}
      </g>
    )
  }
  {
    step === 2 && (
      <g>
        <rect
          x="146"
          y="104"
          width="76"
          height="20"
          rx="10"
          fill="#14141f"
          stroke="#2c2c42"
        />
        <rect x="156" y="111" width="56" height="6" rx="3" fill="#2c2c42" />
        <rect x="156" y="111" width="11" height="6" rx="3" fill="#00cec9" />
      </g>
    )
  }
  {
    step === 3 && (
      <g>
        <rect
          x="120"
          y="16"
          width="62"
          height="18"
          rx="4"
          fill="#2f2f48"
          stroke="#a29bfe"
          stroke-width="1.5"
        />
        <circle cx="130" cy="25" r="3.2" fill={dots[2]} />
        <rect x="137" y="23" width="36" height="4" rx="2" fill="#a3a3bd" />
        <path
          d="M128 82 C 178 82 172 52 154 40"
          fill="none"
          stroke="#a29bfe"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-dasharray="4 5"
        />
        <path
          d="M149 44 L154 38 L159 45"
          fill="none"
          stroke="#a29bfe"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
      </g>
    )
  }
  <circle
    cx="214"
    cy="21"
    r="8"
    fill="#2f2f48"
    stroke={step === 1 ? '#6c5ce7' : '#2f2f48'}
    stroke-width="2.5"></circle>
  <circle cx="214" cy="21" r="5.2" fill="#fdd835"></circle>
  <circle cx="212.2" cy="20.2" r="0.9" fill="#4e342e"></circle>
  <circle cx="215.8" cy="20.2" r="0.9" fill="#4e342e"></circle>
  {
    step === 1 && (
      <path
        d="M217 24 L217 38 L220.5 34.5 L223 40 L225.2 39 L222.7 33.5 L227.5 33.5 Z"
        fill="#000"
        stroke="#fff"
        stroke-width="1.2"
        stroke-linejoin="round"
      />
    )
  }
</svg>
