---
import { Image } from 'astro:assets';
import icon from '../assets/icon.png';
import { SITE } from '../consts';

const year = new Date().getFullYear();
const links = [
  { href: SITE.chromeStore, label: 'Chrome Web Store' },
  { href: '/privacy/', label: 'Privacy Policy' },
  { href: SITE.support, label: 'Help and bug reports' },
];
---

<footer class="border-t border-border px-6 py-12">
  <div
    class="mx-auto flex max-w-6xl flex-col gap-8 md:flex-row md:items-center md:justify-between"
  >
    <div class="flex items-center gap-3">
      <Image src={icon} alt="" width={40} height={40} class="size-10" />
      <div>
        <p class="font-mono font-bold">I Hate Tabs</p>
        <p class="text-sm text-text-secondary">
          Made by a person with too many open tabs.
        </p>
      </div>
    </div>
    <nav aria-label="Footer">
      <ul class="flex flex-wrap gap-x-6 gap-y-2 text-sm text-text-secondary">
        {
          links.map(link => (
            <li>
              <a href={link.href} class="transition hover:text-text-primary">
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
  <p class="mx-auto mt-8 max-w-6xl text-sm text-text-secondary">
    &copy; {year} {SITE.author}
  </p>
</footer>
