---
import StepArt from './StepArt.astro';

const steps = [
  {
    label: 'Click',
    text: 'Click the I Hate Tabs button. All tabs in the window go into one saved group (a session), and they close.',
  },
  {
    label: 'Relax',
    text: 'Now only one tab is open: your list. Your computer has its memory back.',
  },
  {
    label: 'Restore',
    text: 'Click a tab to open it again. Or click Restore to open the whole session.',
  },
] as const;
---

<section class="px-6 py-24" id="how-it-works" aria-labelledby="how-title">
  <div class="mx-auto max-w-6xl">
    <p class="eyebrow text-center">How it works</p>
    <h2
      id="how-title"
      class="mt-3 text-center text-3xl font-bold tracking-tight md:text-5xl"
    >
      Three steps. Nothing to learn.
    </h2>
    <ol class="mt-14 grid grid-cols-1 gap-6 md:grid-cols-3">
      {
        steps.map((step, i) => (
          <li class="rounded-2xl border border-border bg-surface p-6">
            <StepArt step={(i + 1) as 1 | 2 | 3} />
            <h3 class="mt-5 flex items-baseline gap-3 font-mono text-xl font-bold">
              <span class="text-sm text-accent-hover">{i + 1}</span>{' '}
              {step.label}
            </h3>
            <p class="mt-2 leading-relaxed text-text-secondary">{step.text}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
