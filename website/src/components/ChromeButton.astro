---
import { SITE } from '../consts';

interface Props {
  small?: boolean;
  class?: string;
}

const { small = false, class: className } = Astro.props;
---

<a
  href={SITE.chromeStore}
  class:list={['btn-primary', small && 'btn-small', className]}
>
  <svg
    xmlns="http://www.w3.org/2000/svg"
    width={small ? 16 : 22}
    height={small ? 16 : 22}
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <circle cx="12" cy="12" r="10"></circle>
    <circle cx="12" cy="12" r="4"></circle>
    <line x1="21.17" y1="8" x2="12" y2="8"></line>
    <line x1="3.95" y1="6.06" x2="8.54" y2="14"></line>
    <line x1="10.88" y1="21.94" x2="15.46" y2="14"></line>
  </svg>
  {small ? 'Add to Chrome' : 'Add to Chrome, it’s free'}
</a>
