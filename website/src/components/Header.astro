---
import { Image } from 'astro:assets';
import icon from '../assets/icon.png';
import ChromeButton from './ChromeButton.astro';

const links = [
  { href: '/#how-it-works', label: 'How it works' },
  { href: '/#features', label: 'Features' },
  { href: '/#privacy', label: 'Privacy' },
  { href: '/#faq', label: 'FAQ' },
];
---

<header
  class="sticky top-0 z-50 border-b border-border/70 bg-bg/80 backdrop-blur-md"
>
  <div class="mx-auto flex h-16 max-w-6xl items-center gap-8 px-6">
    <a
      href="/"
      class="flex items-center gap-2.5 font-mono text-base font-bold whitespace-nowrap sm:text-lg"
    >
      <Image src={icon} alt="" width={32} height={32} class="size-8" />
      I Hate Tabs
    </a>
    <nav aria-label="Main" class="ml-auto hidden md:block">
      <ul class="flex gap-7 text-sm text-text-secondary">
        {
          links.map(link => (
            <li>
              <a href={link.href} class="transition hover:text-text-primary">
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <ChromeButton small class="ml-auto md:ml-0" />
  </div>
</header>
